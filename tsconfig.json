{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2016",
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": true,
        "outDir": "build",
        "resolveJsonModule": true,
        "strictNullChecks": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "strict": true,
        "noUnusedLocals": true,
        "baseUrl": ".",
        "skipLibCheck": true,
        "paths": {
            "*": [
                "node_modules/*",
                "src/@custom_types/*"
            ],
            "minmax-wt-alpha-beta-pruning": [
                "src/@custom_types/minmax-wt-alpha-beta-pruning.d.ts"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}
