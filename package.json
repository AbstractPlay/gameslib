{
  "name": "@abstractplay/gameslib",
  "version": "1.0.0-ci-33416597828.0",
  "description": "TypeScript implementations of the core Abstract Play games, intended to be wrapped by the front- and backends",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "node": "./build/index.js",
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index-browser.js"
    },
    "./build/index.js": "./build/index.js",
    "./build/index-browser.js": "./build/index-browser.js",
    "./build/*": "./build/*",
    "./package.json": "./package.json",
    "./i18n-node": {
      "types": "./build/i18n-node.d.ts",
      "import": "./build/i18n-node.js"
    },
    "./i18n-browser": {
      "types": "./build/i18n-browser.d.ts",
      "import": "./build/i18n-browser.js"
    },
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "generate-registry": "node scripts/generate-registry.mjs",
    "check-registry": "node scripts/check-registry.mjs",
    "filter-locales-prod": "node scripts/filter-locales-prod.mjs",
    "pretest": "node scripts/patch-honeycomb-grid-dts.mjs && node scripts/generate-registry.mjs && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "npm run json2ts && npm run generate-registry && npm run build-ts && node scripts/post-build.mjs && npm run check-registry && npm run lint",
    "build-ts": "node scripts/patch-honeycomb-grid-dts.mjs && tsc && npm pack",
    "test0": "mocha test/common/graphs/hexMoon.test.ts",
    "test": "mocha",
    "test:scripts": "node --test test/scripts/*.test.mjs",
    "test:postbuild": "node scripts/smoke-package-entry.mjs",
    "test:consumer": "node scripts/smoke-consumer-node.mjs",
    "lint": "npm run check-weblate-keys && node scripts/check-ci-deps.mjs && npx eslint .",
    "dist-dev": "rimraf dist && vite build --config playground/vite.config.ts && shx cp -r locales dist/",
    "playground": "npm run dist-dev && shx cp ./playground/playground.* ./dist && shx cp ./playground/*.mjs ./dist/ && shx cp ./playground/index.html ./dist",
    "playground:serve": "vite --config playground/vite.config.ts",
    "predist-dev": "node scripts/generate-registry.mjs",
    "dist-prod": "rimraf dist && vite build --config playground/vite.config.ts --mode production && shx cp -r locales dist/",
    "predist-prod": "node scripts/generate-registry.mjs",
    "full-dev": "npm run test && npm run build && npm run dist-dev && npm run deploy",
    "full-prod": "npm run test && npm run build && npm run dist-prod && npm run deploy",
    "deploy": "shx cp ./playground/playground.* ./dist && shx cp ./playground/*.mjs ./dist/ && shx cp ./playground/index.html ./dist && npx serverless client deploy --no-confirm --no-delete-contents",
    "deploy:ci": "shx cp ./playground/playground.* ./dist && shx cp ./playground/*.mjs ./dist/ && shx cp ./playground/index.html ./dist && npx serverless client deploy --no-confirm --no-delete-contents",
    "translate": "node scripts/translate.mjs locales/en/apgames.json locales/en/apresults.json",
    "prune-locales": "node scripts/locale-prune.mjs locales/en/apgames.json locales/en/apresults.json",
    "check-weblate-keys": "node scripts/check-weblate-keys.mjs",
    "check-locale-readiness": "node scripts/check-locale-readiness.mjs",
    "check-links": "node scripts/check-links.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "fetch-turnModel-fixtures": "tsx scripts/fetch-turnModel-fixtures.ts",
    "fetch-chat-golden-fixtures": "tsx scripts/fetch-turnModel-fixtures.ts --chat-only",
    "fetch-extra-chat-fixtures": "tsx scripts/fetch-turnModel-fixtures.ts --extra-chat",
    "fetch-frogger-dev-fixtures": "tsx scripts/fetch-frogger-dev-fixtures.ts",
    "refresh-turnModel-golden": "tsx scripts/refresh-turnModel-golden-state.ts",
    "refresh-turnModel-golden-moves": "tsx scripts/refresh-turnModel-golden-moves.ts",
    "refresh-chat-golden": "tsx scripts/refresh-chat-golden.ts",
    "refresh-chat-golden-entries": "tsx scripts/refresh-chat-golden-entries.ts",
    "verify-phase3-chat-fixtures": "tsx scripts/verify-phase3-chat-fixtures.ts",
    "verify-phase4-chat-fixtures": "tsx scripts/verify-phase4-chat-fixtures.ts",
    "verify-phase5-chat-fixtures": "tsx scripts/verify-phase5-chat-fixtures.ts",
    "json2ts": "npx json2ts -i src/schemas/gameinfo.json -o src/schemas/gameinfo.d.ts && npx json2ts -i src/schemas/moveresults.json -o src/schemas/moveresults.d.ts && npx json2ts -i src/games/tafl/ruleset.json -o src/games/tafl/ruleset.d.ts",
    "npm-login": "npm login --scope=@abstractplay --auth-type=web --registry=https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "AbstractPlay/gameslib"
  },
  "author": "Aaron Dalton <aaron@daltons.ca> (https://www.perlkonig.com/)",
  "license": "MIT",
  "keywords": [
    "abstractplay",
    "games"
  ],
  "engines": {
    "node": ">=24",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@eslint/js": "^9.26.0",
    "@google/genai": "^2.13.0",
    "@types/chai": "^4.3.4",
    "@types/earcut": "^2.1.4",
    "@types/mocha": "^10.0.10",
    "@types/seedrandom": "^3.0.8",
    "@types/svgdom": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "chai": "^4.3.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-unicorn": "^59.0.1",
    "graphology-svg": "^0.1.3",
    "graphology-types": "^0.24.7",
    "i18next-resources-to-backend": "^1.2.1",
    "json-schema-to-typescript": "^15.0.4",
    "mocha": "^11.2.2",
    "rimraf": "^5.0.1",
    "serverless": "3.40.0-19128fad",
    "serverless-finch": "^4.0.3",
    "shx": "^0.4.0",
    "svgdom": "^0.1.19",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@abstractplay/recranks": "latest",
    "@abstractplay/renderer": "1.0.0-ci-33416463329.0",
    "@turf/boolean-contains": "^6.5.0",
    "@turf/boolean-intersects": "^6.5.0",
    "@turf/boolean-point-in-polygon": "^6.5.0",
    "@turf/boolean-within": "^6.5.0",
    "@turf/difference": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "@turf/points-within-polygon": "^6.5.0",
    "@types/fnv-plus": "^1.3.2",
    "earcut": "^2.2.4",
    "fnv-plus": "^1.3.1",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-shortest-path": "^2.0.2",
    "graphology-simple-path": "^0.2.0",
    "graphology-traversal": "^0.3.1",
    "honeycomb-grid": "^4.1.5",
    "i18next": "^21.10.0",
    "i18next-http-backend": "^2.2.0",
    "js-combinatorics": "^2.1.2",
    "json-stringify-deterministic": "^1.0.12",
    "lodash": "^4.17.21",
    "minmax-wt-alpha-beta-pruning": "^1.0.5",
    "nanoid": "^5.1.5",
    "seedrandom": "^3.0.5"
  }
}
